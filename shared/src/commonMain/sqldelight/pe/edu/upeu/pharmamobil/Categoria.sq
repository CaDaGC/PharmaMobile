CREATE TABLE categoria (
    id INTEGER NOT NULL PRIMARY KEY,
    nombre TEXT NOT NULL,
    descripcion TEXT NOT NULL,
    estado INTEGER NOT NULL,
    pendiente INTEGER NOT NULL DEFAULT 0,
    intentos INTEGER NOT NULL DEFAULT 0,
    ultimoError TEXT
);

listarTodas:
SELECT * FROM categoria ORDER BY nombre ASC;

listarPendientes:
SELECT * FROM categoria WHERE pendiente = 1 AND intentos < :maxIntentos;

contarPendientes:
SELECT COUNT(*) FROM categoria WHERE pendiente = 1 AND intentos < :maxIntentos;

contarFallidas:
SELECT COUNT(*) FROM categoria WHERE pendiente = 1 AND intentos >= :maxIntentos;

sumarIntento:
UPDATE categoria SET intentos = intentos + 1, ultimoError = :ultimoError WHERE id = :id;

marcarComoFallida:
UPDATE categoria SET intentos = :intentos, ultimoError = :error WHERE id = :id;

confirmarSincronizacion:
UPDATE categoria SET id = :idServidor, pendiente = 0, intentos = 0, ultimoError = NULL WHERE id = :idLocal;

reemplazarSincronizados:
DELETE FROM categoria WHERE pendiente = 0;

insertar:
INSERT OR REPLACE INTO categoria
VALUES (?, ?, ?, ?, ?, ?, ?);

siguienteIdLocal:
SELECT COALESCE(MIN(id), 0) FROM categoria;